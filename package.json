{
  "name": "launchwizard",
  "displayName": "LaunchWizard",
  "description": "Pre-flight build check & 1-click shareable preview engine for vibe coders. Catch production TypeScript & bundler build errors before deploy, and get instant mobile preview links.",
  "version": "0.2.1",
  "pricing": "Free",
  "publisher": "dr-opensource",
  "author": "Dr. Shubham Kashyap",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrOpenSource/LaunchWizard.git"
  },
  "bugs": {
    "url": "https://github.com/DrOpenSource/LaunchWizard/issues"
  },
  "homepage": "https://launchwizard.taqnik.in",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "preflight",
    "build check",
    "typescript",
    "live preview",
    "share link",
    "vibe coding",
    "nextjs",
    "vite",
    "testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "launchwizard.runPreFlight",
        "title": "LaunchWizard: Run Pre-Flight Build Check",
        "category": "LaunchWizard"
      },
      {
        "command": "launchwizard.startPreview",
        "title": "LaunchWizard: 1-Click Get Live Shareable Preview Link",
        "category": "LaunchWizard"
      },
      {
        "command": "launchwizard.stopPreview",
        "title": "LaunchWizard: Stop Active Preview Link",
        "category": "LaunchWizard"
      },
      {
        "command": "launchwizard.autoHealAll",
        "title": "LaunchWizard: 1-Click Auto-Heal Build Blockers",
        "category": "LaunchWizard"
      },
      {
        "command": "launchwizard.showMobileQr",
        "title": "LaunchWizard: Show Mobile QR Code",
        "category": "LaunchWizard"
      },
      {
        "command": "launchwizard.activateLicense",
        "title": "LaunchWizard: Activate Pro License",
        "category": "LaunchWizard"
      },
      {
        "command": "launchwizard.buyLicense",
        "title": "LaunchWizard: Get Pro Lifetime License",
        "category": "LaunchWizard"
      },
      {
        "command": "launchwizard.openWebsite",
        "title": "LaunchWizard: Visit Documentation Website",
        "category": "LaunchWizard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "launchwizard-deck",
          "title": "LaunchWizard",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "launchwizard-deck": [
        {
          "type": "webview",
          "id": "launchwizard.preFlightDeck",
          "name": "Pre-Flight Deck"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit",
    "build": "node esbuild.config.mjs",
    "build:site": "node scripts/build-site.mjs",
    "deploy:site": "npm run build:site && npx wrangler deploy",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npx -y @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "jsqr": "1.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4"
  }
}
