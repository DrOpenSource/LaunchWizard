{
  "name": "shipwizard",
  "displayName": "ShipWizard",
  "description": "Pre-flight build check & 1-click shareable preview engine for vibe coders. Catch production TypeScript & bundler build errors before deploy, and get instant mobile preview links.",
  "version": "0.1.5",
  "pricing": "Free",
  "publisher": "dr-opensource",
  "author": "Dr. Shubham Kashyap",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrOpenSource/ShipWizard.git"
  },
  "bugs": {
    "url": "https://github.com/DrOpenSource/ShipWizard/issues"
  },
  "homepage": "https://shipwizard.taqnik.in",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "preflight",
    "build check",
    "typescript",
    "live preview",
    "share link",
    "vibe coding",
    "nextjs",
    "vite",
    "testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shipwizard.runPreFlight",
        "title": "ShipWizard: Run Pre-Flight Build Check",
        "category": "ShipWizard"
      },
      {
        "command": "shipwizard.startPreview",
        "title": "ShipWizard: 1-Click Get Live Shareable Preview Link",
        "category": "ShipWizard"
      },
      {
        "command": "shipwizard.stopPreview",
        "title": "ShipWizard: Stop Active Preview Link",
        "category": "ShipWizard"
      },
      {
        "command": "shipwizard.autoHealAll",
        "title": "ShipWizard: 1-Click Auto-Heal Build Blockers",
        "category": "ShipWizard"
      },
      {
        "command": "shipwizard.showMobileQr",
        "title": "ShipWizard: Show Mobile QR Code",
        "category": "ShipWizard"
      },
      {
        "command": "shipwizard.activateLicense",
        "title": "ShipWizard: Activate Pro License",
        "category": "ShipWizard"
      },
      {
        "command": "shipwizard.buyLicense",
        "title": "ShipWizard: Get Pro Lifetime License",
        "category": "ShipWizard"
      },
      {
        "command": "shipwizard.openWebsite",
        "title": "ShipWizard: Visit Documentation Website",
        "category": "ShipWizard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shipwizard-deck",
          "title": "ShipWizard",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "shipwizard-deck": [
        {
          "type": "webview",
          "id": "shipwizard.preFlightDeck",
          "name": "Pre-Flight Deck"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit",
    "build": "node esbuild.config.mjs",
    "build:site": "node scripts/build-site.mjs",
    "deploy:site": "npm run build:site && npx wrangler deploy",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npx -y @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
